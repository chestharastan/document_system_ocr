# Paths are relative to the project root (the folder that holds backend/ and .model/).
MODEL_ROOT=.model
MODEL_MANIFEST=.model/v2/models.json

# Active model per stage (manifest ids); empty = the manifest "defaults".
LAYOUT_MODEL=
TEXTDET_MODEL=
REC_MODEL=
# Future 4th stage (post-correction). Only "none" ships.
POSTCORRECT=none

# onnxruntime: auto | cpu | cuda   (auto = CUDA if onnxruntime-gpu is installed and a GPU is visible)
ORT_DEVICE=auto
ORT_THREADS=4
VERIFY_SHA256=true
WARMUP=true

# Input limits: per-file upload size (413), files per request, long side (bigger pages are downscaled
# on upload, coordinates refer to the stored image), pixel cap checked before decoding (422)
MAX_UPLOAD_MB=40
MAX_FILES=50
MAX_IMAGE_SIDE=3600
MAX_IMAGE_PIXELS=150000000

# Stage 1 - layout
LAYOUT_CONF=0.3
LAYOUT_IOU=0.5
LAYOUT_MAX_DET=300
LAYOUT_DEDUPE_IOU=0.7
PAGE_SIZED_FIGURE=0.5

# Stage 2 - DB text-line detection (tuned defaults from det/web/server.py)
DET_THRESH=0.3
DET_BOX_THRESH=0.5
DET_UNCLIP_RATIO=1.6
DET_V_EXTRA=1.0
DET_LONG_MIN=1600
DET_LONG_MAX=2200
DET_CASCADE=true

# Stage 3 - recognition
REC_BATCH=16

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
